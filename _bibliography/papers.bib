@inproceedings{xing2024efuf,
  abbr={EMNLP},
  title={EFUF: Efficient Fine-grained Unlearning Framework for Mitigating Hallucinations in Multimodal Large Language Models},
  author={Xing, Shangyu and Zhao, Fei and Wu, Zhen and An, Tuo and Chen, Weihao and Li, Chunhui and Zhang, Jianbing and Dai, Xinyu},
  booktitle={Proceedings of the 2024 Conference on Empirical Methods in Natural Language Processing},
  year={2024},
  bibtex_show={true},
  preview={EFUF.png},
  abstract={Multimodal large language models (MLLMs) have attracted increasing attention in the past few years, but they may still generate descriptions that include objects not present in the corresponding images, a phenomenon known as object hallucination. To eliminate hallucinations, we propose an efficient fine-grained unlearning framework (EFUF), which can eliminate hallucinations without the need for paired data. Extensive experiments show that our method consistently reduces hallucinations while preserving the generation quality with modest computational overhead.},
  pdf={https://arxiv.org/pdf/2402.09801},
  code={https://github.com/starreeze/efuf},
  google_scholar_id={hqOjcs7Dif8C},
  annotation={Accepted at EMNLP 2024}
}


