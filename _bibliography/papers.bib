  abbr={RSS},
  title={Action-to-Action Flow Matching},
  author={Jia, Jindou and Li, Gen and Chen, Xiangyu and An, Tuo and Hu, Yuxuan and Li, Jingliang and Guo, Xinying and Yang, Jianfei},
  booktitle={Proceedings of Robotics: Science and Systems (RSS)},
  year={2026},
  bibtex_show={true},
  preview={a2a.png},
  abstract={We introduce Action-to-Action Flow Matching (A2A), a policy-learning framework that frames imitation learning as a flow-matching problem directly in action space, mapping past actions to future actions conditioned on observations. Compared with regression-based and diffusion-based policies, A2A delivers more efficient sampling and stronger generalization in robot manipulation.},
  pdf={https://arxiv.org/pdf/2602.07322},
  code={https://github.com/JIAjindou/A2A_Flow_Matching},
  website={https://lorenzo-0-0.github.io/A2A_Flow_Matching/},
  google_scholar_id={UeHWp8X0CEIC},
  annotation={Accepted at RSS 2026 - arXiv:2602.07322}
}

@article{hou2026worldmodel,
